{
  "name": "ellipsis.js",
  "version": "1.0.1",
  "description": "A tiny JavaScript API around native CSS line-clamp",
  "main": "ellipsis.js",
  "module": "ellipsis.mjs",
  "exports": {
    ".": {
      "import": "./ellipsis.mjs",
      "require": "./ellipsis.js"
    },
    "./react": "./react.mjs",
    "./ellipsis.js": "./ellipsis.js",
    "./ellipsis.min.js": "./ellipsis.min.js"
  },
  "files": [
    "ellipsis.js",
    "ellipsis.mjs",
    "ellipsis.min.js",
    "react.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "terser ellipsis.js --compress --mangle --output ellipsis.min.js",
    "prepublishOnly": "npm test && npm run build",
    "test": "node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glinford/ellipsis.js.git"
  },
  "keywords": [
    "ellipsis",
    "js",
    "multiline",
    "clamp",
    "complex",
    "css"
  ],
  "author": "glinford",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/glinford/ellipsis.js/issues"
  },
  "homepage": "https://github.com/glinford/ellipsis.js#readme",
  "devDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.49.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
